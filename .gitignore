# Python environment
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Trained model files — share via Google Drive link in README
*.keras
*.h5

# All data files — reproduced by running pipeline
data/

# Generated outputs — reproduced by running pipeline
outputs/

# Logs — runtime output
logs/

# Windows artifacts
Thumbs.db
desktop.ini

# IDE
.vscode/
*.code-workspace

# Environment variables
.env

# Jupyter
.ipynb_checkpoints/

# Committed model artifacts — pipeline needs these in CI (small, static, ~300KB total)
# These override the *.keras and data/ ignore rules above for four specific files.
!data/
data/*
!data/gru_best_model_7j.keras
!data/gru_regime_model.keras
!data/regime_scaler_X.pkl
!data/cost_ratio_config.json

# Dashboard JSON — the data contract the frontend consumes; committed by CI each run
# data/* (above) re-ignores the dashboard subdir, so un-ignore the dir then its JSON files.
!data/dashboard/
!data/dashboard/*.json